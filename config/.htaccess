# Nada dentro de config/ debe servirse por HTTP: aquí viven la contraseña de Admin
# (admin.json), el secreto de los cupones, las credenciales de Square/PayPal, los
# precios/textos y los propios cupones. proxy.php los lee/escribe por filesystem.
#
# IMPORTANTE: el bloqueo va por FICHERO (FilesMatch), no por carpeta ("Require all
# denied" a secas). La API "/config" del sitio se reescribe (RewriteRule en el
# .htaccess raíz) hacia /proxy.php, pero como la URL empieza igual que esta carpeta
# ("config"), un "deny" a nivel de directorio bloquearía también esa API con 403
# antes de que la reescritura llegara a ejecutarse. Por-fichero no tiene ese problema
# porque nunca se sirve un fichero real de dentro de config/ para esa ruta.
<FilesMatch ".">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch ".">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
