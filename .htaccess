Options -MultiViews
RewriteEngine On

RewriteBase /

# Bloquear acceso público directo a logs y cookies de sesión Sanctum contra Laravel:
# pueden contener cuerpos de petición completos (tokens de pago, datos de contacto).
<FilesMatch "\.(log|txt)$|^pba_cookies">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(log|txt)$|^pba_cookies">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# CSP: limitada a los orígenes que la app usa de verdad (jsDelivr/CDN, Square, PayPal).
# Antes era "default-src *" — cualquier script de cualquier origen, lo que convierte un
# XSS o un CDN comprometido en robo de tarjetas en el formulario de pago.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://web.squarecdn.com https://js.squareup.com https://www.paypal.com https://www.paypalobjects.com https://*.paypal.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net https://connect.squareup.com https://pci-connect.squareup.com https://*.squareup.com https://*.squarecdn.com https://api-m.paypal.com https://api-m.sandbox.paypal.com https://www.paypal.com https://*.paypal.com; frame-src https://web.squarecdn.com https://*.squareup.com https://www.paypal.com https://*.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<IfModule mod_setenvif.c>
    SetEnvIf HTTPS on PBA_HTTPS
</IfModule>
Header always set Strict-Transport-Security "max-age=15552000" env=PBA_HTTPS

# ¡IMPORTANTE! Las reglas de API DEBEN ir ANTES de la regla de archivos/directorios reales
# Porque /config/ es una carpeta real que existe, Apache la ve como directorio
# y no la reescribe si la regla de archivos/directorios reales viene primero

# Config endpoints - ANTES que "archivos reales"
RewriteRule ^config/?$ /proxy.php [PT,L,QSA]

# Verificación de la contraseña de Admin (sin sesión, ver proxy.php)
RewriteRule ^auth/.*$ /proxy.php [PT,L,QSA]

# Payment endpoint
RewriteRule ^process-payment/?$ /proxy.php [PT,L,QSA]

# APIs y proxy
RewriteRule ^health$ /proxy.php [PT,L,QSA]
RewriteRule ^print/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^printbox/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^proxy-image/.*$ /proxy.php [PT,L,QSA]
RewriteRule ^paypal/.*$ /proxy.php [PT,L,QSA]

# Coupon endpoints (generación, validación, canje y listado)
RewriteRule ^coupon/create$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/validate$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/redeem$ /proxy.php [PT,L,QSA]
RewriteRule ^coupon/list$ /proxy.php [PT,L,QSA]

# AHORA sí, permitir archivos y directorios reales (index.html, CSS, JS, imágenes, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router: todo lo demás a index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]